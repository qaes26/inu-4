# ==============================================================================
# نموذج ملف الإعدادات البيئية للمشروع (.env.example)
# انسخ هذا الملف إلى .env وضع مفتاح الـ API الخاص بك
# ==============================================================================

# مفتاح واجهة الذكاء الاصطناعي (يدعم مفاتيح Groq gsk_... ومفاتيح OpenAI sk-...)
AI_API_KEY=your_api_key_here

# نموذج الذكاء الاصطناعي
# للـ Groq: openai/gpt-oss-120b أو allam-2-7b
# للـ OpenAI: gpt-4o-mini أو gpt-4o
AI_MODEL=openai/gpt-oss-120b

# إعدادات الخادم
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

